import { Button, ComboBox, LineEdit, TextEdit, ListView, ScrollView } from "std-widgets.slint";

export struct Row {
    id: string,
    summary: string,
}

export struct Seg {
    text: string,
    color: color,
}

export struct Line {
    segs: [Seg],
}

export struct Diag {
    text: string,
    color: color,
}

export component App inherits Window {
    title: "synthentic-sample";
    preferred-width: 1400px;
    min-width: 1000px;
    preferred-height: 800px;

    in property <[string]> factories;
    in property <string> factory-description;
    in property <[Row]> rows;
    in property <string> status;
    in-out property <string> instruction;
    in-out property <string> input-text;
    in-out property <string> output-text;
    in property <string> compiled-text;
    in property <bool> compile-failed;
    in property <bool> compiling;
    in property <int> pending-compiles;
    in property <bool> importing;
    in-out property <string> repo-text;
    in property <[Line]> compiled-lines;
    in property <[Diag]> diagnostics;
    in property <color> pane-background: #1e2127;
    in property <bool> highlight-enabled: true;
    in-out property <int> selected: -1;
    in-out property <string> seed-text: "0";
    in-out property <string> count-text: "10";

    callback factory-changed(int);
    callback generate(string, string);
    callback select(int);
    callback delete-selected();
    callback instruction-edited(string);
    callback input-edited(string);
    callback output-edited(string);
    callback recompile();
    callback import-repo(string);

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // Left: factory controls + list of pairs
        VerticalLayout {
            width: 280px;
            spacing: 6px;

            ComboBox {
                model: root.factories;
                selected(_) => { root.factory-changed(self.current-index); }
            }
            Text {
                text: root.factory-description;
                wrap: word-wrap;
                font-size: 11px;
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "seed"; vertical-alignment: center; }
                LineEdit { text <=> root.seed-text; }
                Text { text: "count"; vertical-alignment: center; }
                LineEdit { width: 60px; text <=> root.count-text; }
            }
            Button {
                text: "Generate";
                primary: true;
                clicked => { root.generate(root.seed-text, root.count-text); }
            }

            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: "owner/repo[@ref]";
                    text <=> root.repo-text;
                    accepted => { root.import-repo(root.repo-text); }
                }
                Button {
                    text: root.importing ? "Importing…" : "Import";
                    enabled: !root.importing;
                    clicked => { root.import-repo(root.repo-text); }
                }
            }

            ListView {
                for row[i] in root.rows: Rectangle {
                    height: 36px;
                    background: i == root.selected ? #3d6fd8 : (touch.has-hover ? #8884 : transparent);
                    touch := TouchArea { clicked => { root.select(i); } }
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: row.summary;
                        overflow: elide;
                        vertical-alignment: center;
                        color: i == root.selected ? white : black;
                    }
                }
            }

            Text {
                text: root.rows.length + " pairs" + (root.pending-compiles > 0 ? " — compiling " + root.pending-compiles + "…" : "");
                font-size: 11px;
            }
            Button {
                text: "Delete selected";
                enabled: root.selected >= 0;
                clicked => { root.delete-selected(); }
            }
            Text { text: root.status; font-size: 11px; wrap: word-wrap; }
        }

        // Right: editor
        VerticalLayout {
            spacing: 6px;
            Text { text: "Instruction"; font-weight: 700; }
            TextEdit {
                height: 70px;
                enabled: root.selected >= 0;
                text <=> root.instruction;
                edited(t) => { root.instruction-edited(t); }
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;
                    spacing: 4px;
                    Text { text: "Input"; font-weight: 700; }
                    TextEdit {
                        enabled: root.selected >= 0;
                        font-size: 12px;
                        text <=> root.input-text;
                        edited(t) => { root.input-edited(t); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: "Output"; font-weight: 700; horizontal-stretch: 1; }
                        Button { text: "Recompile"; enabled: root.selected >= 0; clicked => { root.recompile(); } }
                    }
                    TextEdit {
                        enabled: root.selected >= 0;
                        font-size: 12px;
                        text <=> root.output-text;
                        edited(t) => { root.output-edited(t); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;
                    spacing: 4px;
                    Text {
                        text: root.compile-failed ? "Compiled — ERROR" : (root.compiling ? "Compiled — compiling…" : "Compiled (sentinel → RBS)");
                        font-weight: 700;
                        color: root.compile-failed ? #d33 : black;
                    }
                    if root.highlight-enabled: Rectangle {
                        background: root.pane-background;
                        border-radius: 4px;
                        clip: true;
                        ListView {
                            for line in root.compiled-lines: HorizontalLayout {
                                height: 16px;
                                padding-left: 6px;
                                alignment: start;
                                for seg in line.segs: Text {
                                    text: seg.text;
                                    color: seg.color;
                                    font-family: "Menlo";
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                    if !root.highlight-enabled: TextEdit {
                        enabled: root.selected >= 0;
                        read-only: true;
                        font-size: 12px;
                        text: root.compiled-text;
                    }
                    for d in root.diagnostics: Text {
                        text: d.text;
                        color: d.color;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
