import { Button, CheckBox, ComboBox, LineEdit, TextEdit, ListView, ScrollView } from "std-widgets.slint";

export struct Row {
    id: string,
    summary: string,
    /// 0 none, 1 compiled RBS matches the source, 2 mismatch, 3 compiling.
    verdict: int,
}

export struct Seg {
    text: string,
    color: color,
}

export struct Line {
    segs: [Seg],
}

export struct Diag {
    text: string,
    color: color,
}

export component App inherits Window {
    title: "synthentic-sample";
    preferred-width: 1400px;
    min-width: 1000px;
    preferred-height: 800px;

    in property <[string]> factories;
    in property <string> factory-description;
    in property <[Row]> rows;
    in property <string> status;
    in-out property <string> instruction;
    in-out property <string> input-text;
    in-out property <string> output-text;
    in property <string> compiled-text;
    in property <bool> compile-failed;
    in property <bool> compiling;
    in property <int> pending-compiles;
    in property <bool> has-selection;
    in property <[string]> gem-names;
    in property <string> counts-text;
    in property <string> verdict-text;
    in property <string> compile-mode;
    in property <color> verdict-color: #888;
    in property <[Diag]> mismatch-lines;
    in-out property <bool> only-mismatches;
    in property <bool> importing;
    in-out property <string> repo-text;
    in property <[Line]> compiled-lines;
    in property <[Diag]> diagnostics;
    in property <color> pane-background: #1e2127;
    in property <bool> highlight-enabled: true;
    in-out property <int> selected: -1;
    in-out property <string> seed-text: "0";
    in-out property <string> count-text: "10";

    callback factory-changed(int);
    callback generate(string, string);
    callback select(int);
    callback delete-selected();
    callback instruction-edited(string);
    callback input-edited(string);
    callback output-edited(string);
    callback recompile();
    callback import-repo(string);
    callback sync-collection();
    callback filter-changed();

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // Left: factory controls + list of pairs
        VerticalLayout {
            width: 280px;
            spacing: 6px;

            ComboBox {
                model: root.factories;
                selected(_) => { root.factory-changed(self.current-index); }
            }
            Text {
                text: root.factory-description;
                wrap: word-wrap;
                font-size: 11px;
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "seed"; vertical-alignment: center; }
                LineEdit { text <=> root.seed-text; }
                Text { text: "count"; vertical-alignment: center; }
                LineEdit { width: 60px; text <=> root.count-text; }
            }
            Button {
                text: "Generate";
                primary: true;
                clicked => { root.generate(root.seed-text, root.count-text); }
            }

            Text { text: "gem_rbs_collection"; font-weight: 700; }
            HorizontalLayout {
                spacing: 6px;
                gem-box := ComboBox {
                    model: root.gem-names;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Import gem";
                    enabled: !root.importing && root.gem-names.length > 0;
                    clicked => { root.import-repo("gem:" + gem-box.current-value); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: root.importing ? "Working…" : "Import all gems";
                    enabled: !root.importing;
                    horizontal-stretch: 1;
                    clicked => { root.import-repo("gems"); }
                }
                Button {
                    text: "Sync";
                    enabled: !root.importing;
                    clicked => { root.sync-collection(); }
                }
            }
            Text {
                text: root.gem-names.length == 0
                    ? "Press Sync to list the collection's gems. Importing also syncs."
                    : root.gem-names.length + " gems (newest version of each)";
                font-size: 11px;
                wrap: word-wrap;
            }

            Text { text: "GitHub repository"; font-weight: 700; }
            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    placeholder-text: "owner/repo[@ref]";
                    text <=> root.repo-text;
                    accepted => { root.import-repo(root.repo-text); }
                }
                Button {
                    text: "Import";
                    enabled: !root.importing;
                    clicked => { root.import-repo(root.repo-text); }
                }
            }

            CheckBox {
                text: "show mismatches only";
                checked <=> root.only-mismatches;
                toggled => { root.filter-changed(); }
            }

            ListView {
                for row[i] in root.rows: Rectangle {
                    height: 36px;
                    background: i == root.selected ? #3d6fd8 : (touch.has-hover ? #8884 : transparent);
                    touch := TouchArea { clicked => { root.select(i); } }
                    Rectangle {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        visible: row.verdict != 0;
                        background: row.verdict == 1 ? #3fb950 : (row.verdict == 2 ? #f85149 : #8b949e);
                    }
                    Text {
                        x: 24px;
                        width: parent.width - 32px;
                        text: row.summary;
                        overflow: elide;
                        vertical-alignment: center;
                        color: i == root.selected ? white : black;
                    }
                }
            }

            Text {
                text: root.counts-text + (root.pending-compiles > 0 ? " — compiling " + root.pending-compiles + "…" : "");
                font-size: 11px;
                wrap: word-wrap;
            }
            Button {
                text: "Delete selected";
                enabled: root.has-selection;
                clicked => { root.delete-selected(); }
            }
            Text { text: root.status; font-size: 11px; wrap: word-wrap; }
        }

        // Right: editor
        VerticalLayout {
            spacing: 6px;
            Text { text: "Instruction"; font-weight: 700; }
            TextEdit {
                height: 70px;
                enabled: root.has-selection;
                text <=> root.instruction;
                edited(t) => { root.instruction-edited(t); }
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;
                    spacing: 4px;
                    Text { text: "Input"; font-weight: 700; }
                    TextEdit {
                        enabled: root.has-selection;
                        font-size: 12px;
                        text <=> root.input-text;
                        edited(t) => { root.input-edited(t); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: "Output"; font-weight: 700; horizontal-stretch: 1; }
                        Button { text: "Recompile"; enabled: root.has-selection; clicked => { root.recompile(); } }
                    }
                    TextEdit {
                        enabled: root.has-selection;
                        font-size: 12px;
                        text <=> root.output-text;
                        edited(t) => { root.output-edited(t); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 240px;
                    spacing: 4px;
                    Text {
                        text: root.compile-failed ? "Compiled — ERROR" : (root.compiling ? "Compiled — compiling…" : "Compiled (sentinel → RBS)");
                        font-weight: 700;
                        color: root.compile-failed ? #d33 : black;
                    }
                    if root.compile-mode != "": Text {
                        text: "compiled " + root.compile-mode;
                        color: #888;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    if root.verdict-text != "": Text {
                        text: root.verdict-text;
                        color: root.verdict-color;
                        font-weight: 700;
                        font-size: 12px;
                    }
                    for m in root.mismatch-lines: Text {
                        text: m.text;
                        color: m.color;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    if root.highlight-enabled: Rectangle {
                        background: root.pane-background;
                        border-radius: 4px;
                        clip: true;
                        ListView {
                            for line in root.compiled-lines: HorizontalLayout {
                                height: 16px;
                                padding-left: 6px;
                                alignment: start;
                                for seg in line.segs: Text {
                                    text: seg.text;
                                    color: seg.color;
                                    font-family: "Menlo";
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                    if !root.highlight-enabled: TextEdit {
                        enabled: root.has-selection;
                        read-only: true;
                        font-size: 12px;
                        text: root.compiled-text;
                    }
                    for d in root.diagnostics: Text {
                        text: d.text;
                        color: d.color;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
