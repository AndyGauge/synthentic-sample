{
  "collection": {
    "url": "https://github.com/ruby/gem_rbs_collection.git",
    "cache_dir": "",
    "gem": "gem",
    "auto_sync": true,
    "jobs": 4,
    "exclude_dirs": ["test", "spec", "vendor", "node_modules", ".git", "tmp", "bin", "examples", "features"]
  },
  "github": {
    "git": "git",
    "max_lines": 120,
    "exclude_dirs": [".git", "vendor", "node_modules", "tmp"],
    "max_file_bytes": 1000000,
    "check_syntax": true,
    "ruby": "ruby"
  },
  "scenario": {
    "default": "gem-rbs-collection",
    "gems": [],
    "synthetic_seed": 0,
    "synthetic_count": 100
  },
  "sentinel": {
    "command": "sentinel",
    "args": ["init"],
    "source": "rubygems",
    "path": "",
    "gem_name": "rbs-sentinel",
    "git_url": "https://github.com/AndyGauge/rbs-sentinel.git",
    "git_ref": "master",
    "cargo": "cargo"
  },
  "lsp": { "enabled": true, "command": "sentinel", "args": ["lsp"] },
  "highlight": {
    "enabled": true,
    "theme": {
      "background": "#1e2127",
      "plain": "#abb2bf",
      "comment": "#5c6370",
      "keyword": "#c678dd",
      "type": "#e5c07b",
      "builtin": "#56b6c2",
      "ivar": "#e06c75",
      "function": "#61afef",
      "punct": "#7f848e",
      "string": "#98c379",
      "error": "#ff6b6b",
      "warning": "#e5c07b"
    }
  }
}
